DISCORD_TOKEN=your-discord-bot-token-here
# Primary brain — OpenRouter free, one key fans out to ~24 :free models.
# Get at https://openrouter.ai/keys — no card, free models cost $0.
# MULTI-KEY: comma-separated, auto-rotates on 429/503. e.g. KEY1,KEY2
OPENROUTER_API_KEY=key1,key2
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional: override backup chain (comma-separated). Defaults tried in order:
# nemotron-3.5-lightning:free, gpt-oss-20b:free, glm-4.5-air:free, qwen3-32b:free
# OPENROUTER_BACKUPS=openai/gpt-oss-20b:free,z-ai/glm-4.5-air:free
# Second leg — Gemini, get at https://aistudio.google.com/
# use gemini-2.5-flash-lite (2.0 was shut down Sep 2026)
# MULTI-KEY: comma-separated, auto-rotates on 429/503. e.g. KEY1,KEY2,KEY3
GEMINI_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash-lite
# Last resort when OpenRouter + Gemini are down
# MULTI-KEY: same, comma-separated
GROQ_API_KEY=key1,key2,key3
GROQ_MODEL=openai/gpt-oss-20b
WATCHDOG_MODEL=openai/gpt-oss-20b
WATCHDOG_ENABLED=true
